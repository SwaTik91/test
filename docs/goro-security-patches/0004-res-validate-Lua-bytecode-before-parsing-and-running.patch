+package res
+
+import (
+	"encoding/binary"
+	"math"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestParseLua51BytecodeRejectsBogusCounts(t *testing.T) {
+	tests := []struct {
+		name string
+		fn   luaRawFunction
+		want string
+	}{
+		{"negative code count", luaRawFunction{codeCount: -1}, "invalid Lua code count"},
+		{"negative constant count", luaRawFunction{constantCount: -7}, "invalid Lua constant count"},
+		{"negative prototype count", luaRawFunction{protoCount: math.MinInt32}, "invalid Lua prototype count"},
+		{"negative line info count", luaRawFunction{lineInfoCount: -1}, "invalid Lua line info count"},
+		{"negative local count", luaRawFunction{localCount: -1}, "invalid Lua local count"},
+		{"negative upvalue count", luaRawFunction{upvalueCount: -1}, "invalid Lua upvalue count"},
+		{"absurd code count", luaRawFunction{codeCount: math.MaxInt32}, "code count 2147483647 exceeds"},
+		{"absurd constant count", luaRawFunction{constantCount: math.MaxInt32}, "constant count 2147483647 exceeds"},
+		{"absurd prototype count", luaRawFunction{protoCount: math.MaxInt32}, "prototype count 2147483647 exceeds"},
+		{"absurd local count", luaRawFunction{localCount: math.MaxInt32}, "local count 2147483647 exceeds"},
+		{"absurd upvalue count", luaRawFunction{upvalueCount: math.MaxInt32}, "upvalue count 2147483647 exceeds"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			start := time.Now()
+			_, err := parseLua51Bytecode(append(luaTestHeader(), test.fn.bytes()...))
+			if err == nil {
+				t.Fatalf("parseLua51Bytecode() = nil error, want %q", test.want)
+			}
+			if !strings.Contains(err.Error(), test.want) {
+				t.Fatalf("parseLua51Bytecode() error = %v, want it to contain %q", err, test.want)
+			}
+			if elapsed := time.Since(start); elapsed > time.Second {
+				t.Fatalf("parseLua51Bytecode() took %s, want an immediate rejection", elapsed)
+			}
+		})
+	}
+}
+
+func TestParseLua51BytecodeRejectsDeepNesting(t *testing.T) {
+	if _, err := parseLua51Bytecode(append(luaTestHeader(), luaNestedFunction(8)...)); err != nil {
+		t.Fatalf("parseLua51Bytecode() error = %v, want shallow nesting to parse", err)
+	}
+	data := append(luaTestHeader(), luaNestedFunction(luaMaxPrototypeDepth+16)...)
+	_, err := parseLua51Bytecode(data)
+	if err == nil {
+		t.Fatal("parseLua51Bytecode() = nil error, want deep nesting to be rejected")
+	}
+	if !strings.Contains(err.Error(), "nested Lua prototypes") {
+		t.Fatalf("parseLua51Bytecode() error = %v, want a nesting depth error", err)
+	}
+}
+
+func TestGopherLuaProtoRejectsDeepNesting(t *testing.T) {
+	fn := luaFunction{maxStackSize: 2}
+	for i := 0; i < luaMaxPrototypeDepth+16; i++ {
+		fn = luaFunction{prototypes: []luaFunction{fn}, maxStackSize: 2}
+	}
+	if _, err := gopherLuaProto(fn, 0); err == nil {
+		t.Fatal("gopherLuaProto() = nil error, want deep nesting to be rejected")
+	}
+}
+
+func TestExecuteLuaFunctionRejectsOutOfRangeRegisters(t *testing.T) {
+	tests := []struct {
+		name string
+		fn   luaFunction
+	}{
+		{"move source", luaFunction{
+			code:         []uint32{luaInstructionABC(luaOpMove, 0, 511, 0)},
+			maxStackSize: 2,
+		}},
+		{"move destination", luaFunction{
+			code:         []uint32{luaInstructionABC(luaOpMove, 255, 0, 0)},
+			maxStackSize: 0,
+		}},
+		{"get table source", luaFunction{
+			code:         []uint32{luaInstructionABC(luaOpGetTable, 0, 511, 0)},
+			maxStackSize: 2,
+		}},
+		{"set table target", luaFunction{
+			code:         []uint32{luaInstructionABC(luaOpSetTable, 255, 511, 511)},
+			maxStackSize: 0,
+		}},
+		{"set list range", luaFunction{
+			code: []uint32{
+				luaInstructionABC(luaOpNewTable, 250, 0, 0),
+				luaInstructionABC(luaOpSetList, 250, 400, 1),
+			},
+			maxStackSize: 255,
+		}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			globals := make(map[string]luaValue)
+			if err := executeLuaFunction(test.fn, globals); err == nil {
+				t.Fatal("executeLuaFunction() = nil error, want an out of range register error")
+			}
+		})
+	}
+}
+
+func TestExecuteLua51BytecodeRejectsOutOfRangeRegisters(t *testing.T) {
+	fn := luaRawFunction{
+		codeCount: 2,
+		code: []uint32{
+			luaInstructionABC(luaOpMove, 0, 511, 0),
+			luaInstructionABC(len(lua51ToGopherLuaOpcode), 0, 0, 0),
+		},
+	}
+	data := append(luaTestHeader(), fn.bytes()...)
+	if err := executeLua51Bytecode(data, make(map[string]luaValue)); err == nil {
+		t.Fatal("executeLua51Bytecode() = nil error, want the register operand to be rejected")
+	}
+}
+
+func TestExecuteLuaFunctionBuildsTables(t *testing.T) {
+	fn := luaFunction{
+		constants: []luaValue{
+			{kind: luaString, str: "List"},
+			{kind: luaNumber, num: 7},
+		},
+		code: []uint32{
+			luaInstructionABC(luaOpNewTable, 0, 0, 0),
+			luaInstructionABx(luaOpLoadK, 1, 1),
+			luaInstructionABC(luaOpSetList, 0, 1, 1),
+			luaInstructionABx(luaOpSetGlobal, 0, 0),
+			luaInstructionABC(luaOpReturn, 0, 1, 0),
+		},
+		maxStackSize: 2,
+	}
+	globals := make(map[string]luaValue)
+	if err := executeLuaFunction(fn, globals); err != nil {
+		t.Fatal(err)
+	}
+	table := globals["List"]
+	if table.kind != luaTable {
+		t.Fatalf("List = %#v, want Lua table", table)
+	}
+	if got := table.table[1]; got.kind != luaNumber || got.num != 7 {
+		t.Fatalf("List[1] = %#v, want Lua number 7", got)
+	}
+}
+
+func TestExecuteLuaFunctionStopsAtStepBudget(t *testing.T) {
+	code := make([]uint32, luaMaxInterpreterSteps+1)
+	for i := range code {
+		code[i] = luaInstructionABC(luaOpMove, 0, 1, 0)
+	}
+	err := executeLuaFunction(luaFunction{code: code, maxStackSize: 2}, make(map[string]luaValue))
+	if err == nil {
+		t.Fatal("executeLuaFunction() = nil error, want the step budget to be exhausted")
+	}
+	if !strings.Contains(err.Error(), "exceeded") {
+		t.Fatalf("executeLuaFunction() error = %v, want a step budget error", err)
+	}
+}
+
+func TestExecuteLuaFunctionWithGopherLuaStopsInfiniteLoop(t *testing.T) {
+	fn := luaFunction{
+		code:         []uint32{luaInstructionABx(luaOpJmp, 0, luaSbxBias-1)},
+		maxStackSize: 2,
+	}
+	start := time.Now()
+	err := executeLuaFunctionWithGopherLua(fn, make(map[string]luaValue), nil)
+	elapsed := time.Since(start)
+	if err == nil {
+		t.Fatal("executeLuaFunctionWithGopherLua() = nil error, want the deadline to fire")
+	}
+	if elapsed > 4*luaExecutionTimeout {
+		t.Fatalf("executeLuaFunctionWithGopherLua() took %s, want it to stop near %s", elapsed, luaExecutionTimeout)
+	}
+}
+
+// luaSbxBias is the signed offset Lua 5.1 applies to sBx operands.
+const luaSbxBias = 131071
+
+type luaRawFunction struct {
+	codeCount     int32
+	code          []uint32
+	constantCount int32
+	protoCount    int32
+	lineInfoCount int32
+	localCount    int32
+	upvalueCount  int32
+}
+
+func (f luaRawFunction) bytes(protos ...[]byte) []byte {
+	out := luaTestString("@hardening.lub")
+	out = luaTestI32(out, 0)
+	out = luaTestI32(out, 0)
+	out = append(out, 0, 0, 0, 2)
+	out = luaTestI32(out, f.codeCount)
+	for _, instruction := range f.code {
+		out = luaTestI32(out, int32(instruction))
+	}
+	out = luaTestI32(out, f.constantCount)
+	out = luaTestI32(out, f.protoCount)
+	for _, proto := range protos {
+		out = append(out, proto...)
+	}
+	out = luaTestI32(out, f.lineInfoCount)
+	out = luaTestI32(out, f.localCount)
+	out = luaTestI32(out, f.upvalueCount)
+	return out
+}
+
+func luaNestedFunction(depth int) []byte {
+	out := luaRawFunction{}.bytes()
+	for i := 0; i < depth; i++ {
+		out = luaRawFunction{protoCount: 1}.bytes(out)
+	}
+	return out
+}
+
+func luaTestHeader() []byte {
+	return []byte{0x1b, 'L', 'u', 'a', 0x51, 0, 1, 4, 4, 4, 8, 0}
+}
+
+func luaTestString(value string) []byte {
+	out := luaTestI32(nil, int32(len(value)+1))
+	out = append(out, value...)
+	return append(out, 0)
+}
+
+func luaTestI32(out []byte, value int32) []byte {
+	var word [4]byte
+	binary.LittleEndian.PutUint32(word[:], uint32(value))
+	return append(out, word[:]...)
+}
