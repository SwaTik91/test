+		r.err = fmt.Errorf("lua register %d out of range", index)
+		return luaValue{}
+	}
+	return r.values[index]
+}
+
+func (r *luaRegisters) set(index int, value luaValue) {
+	if r.err != nil {
+		return
+	}
+	if index < 0 || index >= len(r.values) {
+		r.err = fmt.Errorf("lua register %d out of range", index)
+		return
+	}
+	r.values[index] = value
