From 09ac38c087c85a3628827ad2be0a5d7110b65402 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 24 Aug 2026 23:02:58 +0000
Subject: [PATCH 1/6] network: drop unsynced streams instead of buffering them

An unparseable stream made Framer.Push keep every byte and rescan the whole
buffer for each new chunk, so a server could grow client memory without bound
at quadratic cost. Framing failures now report ErrUnsyncedStream, the framer
releases the bytes it already rejected, pending data is capped, and the read
loop disconnects rather than retrying forever. Outbound trace logs no longer
dump the payload of packets that carry a password or a session token.
---
 network/client.go                | 44 ++++++++++++++++---
 network/framer.go                | 28 +++++++++++-
 network/framer_hardening_test.go | 74 ++++++++++++++++++++++++++++++++
 3 files changed, 139 insertions(+), 7 deletions(-)
 create mode 100644 network/framer_hardening_test.go

diff --git a/network/client.go b/network/client.go
index 5e4a2e2..fe2b915 100644
--- a/network/client.go
+++ b/network/client.go
@@ -44,6 +44,27 @@ type Client struct {
 
 const sendQueueSize = 256
 
+// inboundQueueLimit bounds packets and errors buffered while the game loop is
+// busy, so a flooding server cannot grow them without limit.
+const inboundQueueLimit = 4096
+
+// traceHeadLimits caps how much of an outbound packet may reach the log for
+// opcodes whose payload carries a password or a session token.
+var traceHeadLimits = map[uint16]int{
+	PacketCAPlainLogin: 6,
+	PacketCAEnter:      6,
+	PacketCHDeleteChar: 6,
+}
+
+func tracePacketHead(packet []byte) string {
+	headLen := min(len(packet), 32)
+	if limit, ok := traceHeadLimits[ID(packet)]; ok {
+		headLen = min(headLen, limit)
+		return hex.EncodeToString(packet[:headLen]) + "+redacted"
+	}
+	return hex.EncodeToString(packet[:headLen])
+}
+
 type outboundPacket struct {
 	data     []byte
 	enqueued time.Time
@@ -117,8 +138,7 @@ func (c *Client) Send(data []byte) error {
 	elapsed := time.Since(start)
 
 	if c.trace || elapsed > 2*time.Millisecond {
-		headLen := min(len(packet), 32)
-		glog.Debugf("network enqueue opcode=0x%04X n=%d elapsed=%s head=%s", ID(packet), len(packet), elapsed, hex.EncodeToString(packet[:headLen]))
+		glog.Debugf("network enqueue opcode=0x%04X n=%d elapsed=%s head=%s", ID(packet), len(packet), elapsed, tracePacketHead(packet))
 	}
 	return nil
 }
