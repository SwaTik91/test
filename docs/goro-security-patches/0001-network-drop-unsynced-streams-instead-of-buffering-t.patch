diff --git a/network/framer.go b/network/framer.go
index 49f7955..e6accb0 100644
--- a/network/framer.go
+++ b/network/framer.go
@@ -2,9 +2,18 @@ package network
 
 import (
 	"encoding/binary"
+	"errors"
 	"fmt"
 )
 
+// ErrUnsyncedStream reports a stream that carries no recognizable packet, which
+// cannot be recovered from by discarding more bytes.
+var ErrUnsyncedStream = errors.New("unsynced packet stream")
+
+// maxBufferSize bounds pending bytes well above the 65535-byte ceiling a
+// variable-length packet header can express.
+const maxBufferSize = 128 * 1024
+
 type Framer struct {
 	lengths LengthTable
 	buffer  []byte
@@ -16,6 +25,11 @@ func NewFramer(lengths LengthTable) *Framer {
 
 func (f *Framer) Push(data []byte) ([]Packet, error) {
 	f.buffer = append(f.buffer, data...)
+	if len(f.buffer) > maxBufferSize {
+		pending := len(f.buffer)
+		f.buffer = nil
+		return nil, fmt.Errorf("packet buffer overflow at %d bytes: %w", pending, ErrUnsyncedStream)
+	}
 
 	var packets []Packet
 	for {
@@ -32,8 +46,8 @@ func (f *Framer) Push(data []byte) ([]Packet, error) {
 			if f.resyncToKnownPacket() {
 				continue
 			}
-			f.buffer = f.buffer[1:]
-			return packets, fmt.Errorf("unknown packet id 0x%04X", id)
+			f.discardUnsynced()
+			return packets, fmt.Errorf("unknown packet id 0x%04X: %w", id, ErrUnsyncedStream)
 		}
 
 		if length == -1 {
@@ -58,6 +72,16 @@ func (f *Framer) Push(data []byte) ([]Packet, error) {
 	}
 }
 
+// discardUnsynced drops every byte that resyncToKnownPacket already rejected,
+// keeping only the trailing byte it never inspected as an opcode prefix.
+func (f *Framer) discardUnsynced() {
+	if len(f.buffer) > 1 {
+		f.buffer = append(f.buffer[:0], f.buffer[len(f.buffer)-1])
+		return
+	}
+	f.buffer = nil
+}
+
 func (f *Framer) resyncToKnownPacket() bool {
 	for offset := 1; offset+1 < len(f.buffer); offset++ {
 		id := ID(f.buffer[offset:])
diff --git a/network/framer_hardening_test.go b/network/framer_hardening_test.go
new file mode 100644
index 0000000..0af50e7
--- /dev/null
+++ b/network/framer_hardening_test.go
@@ -0,0 +1,74 @@
+package network
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func TestFramerUnsyncedStreamDiscardsBuffer(t *testing.T) {
+	framer := NewFramer(PacketLengths2008())
+	garbage := make([]byte, 4096)
+	for i := range garbage {
+		garbage[i] = 0xFF
+	}
+
+	packets, err := framer.Push(garbage)
+	if len(packets) != 0 {
+		t.Fatalf("expected no packets, got %d", len(packets))
+	}
+	if !errors.Is(err, ErrUnsyncedStream) {
+		t.Fatalf("expected ErrUnsyncedStream, got %v", err)
+	}
+	if len(framer.buffer) > 1 {
+		t.Fatalf("expected buffer to be discarded, got %d bytes", len(framer.buffer))
+	}
+}
+
+func TestFramerRejectsBufferOverflow(t *testing.T) {
+	framer := NewFramer(LengthTable{})
+	framer.buffer = make([]byte, maxBufferSize)
+
+	if _, err := framer.Push([]byte{0x00, 0x01}); !errors.Is(err, ErrUnsyncedStream) {
+		t.Fatalf("expected ErrUnsyncedStream, got %v", err)
+	}
+	if framer.buffer != nil {
+		t.Fatalf("expected buffer to be released, got %d bytes", len(framer.buffer))
+	}
+}
+
+func TestTracePacketHeadRedactsCredentials(t *testing.T) {
+	packet := BuildAccountLoginPacket(AccountLogin{
+		Version:    24,
+		Username:   "audituser",
+		Password:   "SuperSecret123",
+		ClientType: 1,
+	})
+
+	head := tracePacketHead(packet)
+	if !strings.HasSuffix(head, "+redacted") {
+		t.Fatalf("expected redacted marker, got %q", head)
+	}
+	for _, secret := range []string{"audituser", "SuperSecret123"} {
+		if strings.Contains(head, encodeASCII(secret)) {
+			t.Fatalf("head %q leaks %q", head, secret)
+		}
+	}
+}
+
+func TestTracePacketHeadKeepsOrdinaryPackets(t *testing.T) {
+	packet := []byte{0x89, 0x00, 0x01, 0x02, 0x03, 0x04}
+	if head := tracePacketHead(packet); head != "890001020304" {
+		t.Fatalf("unexpected head %q", head)
+	}
+}
+
+func encodeASCII(value string) string {
+	var b strings.Builder
+	for i := 0; i < len(value); i++ {
+		const digits = "0123456789abcdef"
+		b.WriteByte(digits[value[i]>>4])
+		b.WriteByte(digits[value[i]&0x0f])
+	}
+	return b.String()
+}
