 			}
 			packets, frameErr := c.framer.Push(buf[:n])
 			c.mu.Lock()
+			if len(c.packets)+len(packets) > inboundQueueLimit {
+				c.mu.Unlock()
+				if c.isCurrentConn(conn) {
+					c.addError(fmt.Errorf("inbound packet queue overflow"))
+				}
+				c.clearConn(conn)
+				return
+			}
 			c.packets = append(c.packets, packets...)
-			if frameErr != nil {
+			if frameErr != nil && len(c.errs) < inboundQueueLimit {
 				c.errs = append(c.errs, FrameError{Err: frameErr})
 			}
 			c.mu.Unlock()
+			if errors.Is(frameErr, ErrUnsyncedStream) {
+				if c.isCurrentConn(conn) {
+					c.addError(frameErr)
+				}
+				c.clearConn(conn)
+				return
+			}
 		}
 		if err != nil {
 			if c.isCurrentConn(conn) {
@@ -603,8 +638,7 @@ func (c *Client) writeLoop(conn net.Conn, sendCh <-chan outboundPacket) {
 		}
 		elapsed := time.Since(start)
 		if c.trace || queued > 2*time.Millisecond || elapsed > 2*time.Millisecond {
-			headLen := min(len(packet.data), 32)
-			glog.Debugf("network write opcode=0x%04X n=%d queued=%s elapsed=%s head=%s", ID(packet.data), len(packet.data), queued, elapsed, hex.EncodeToString(packet.data[:headLen]))
+			glog.Debugf("network write opcode=0x%04X n=%d queued=%s elapsed=%s head=%s", ID(packet.data), len(packet.data), queued, elapsed, tracePacketHead(packet.data))
