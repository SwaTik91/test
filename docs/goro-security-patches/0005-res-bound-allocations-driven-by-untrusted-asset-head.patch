+	for i, word := range gr2MagicFF6LE {
+		binary.LittleEndian.PutUint32(data[i*4:], word)
+	}
+	binary.LittleEndian.PutUint32(data[0x20:], 6)
+	binary.LittleEndian.PutUint32(data[0x24:], uint32(len(data)))
+	binary.LittleEndian.PutUint32(data[0x2c:], 0x44-gr2HeaderSize)
+	binary.LittleEndian.PutUint32(data[0x30:], 1)
+	binary.LittleEndian.PutUint32(data[0x44+12:], 0xFFFFFFF0)
+	binary.LittleEndian.PutUint32(data[0x28:], crc32.ChecksumIEEE(data[0x44:]))
+
+	if _, err := ParseGR2Container(data); err == nil {
+		t.Fatal("expected rejection of absurd decompressed size")
+	} else if !strings.Contains(err.Error(), "exceeds limit") {
