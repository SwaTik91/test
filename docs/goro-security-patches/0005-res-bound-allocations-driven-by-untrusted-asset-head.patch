+func TestManagerFindRejectsPathTraversal(t *testing.T) {
+	base := t.TempDir()
+	root := filepath.Join(base, "ro")
+	if err := os.MkdirAll(filepath.Join(root, "data"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(base, "secret.txt"), []byte("top secret"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "data", "clientinfo.xml"), []byte("<clientinfo/>"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	manager := &Manager{Root: root}
+	for _, name := range []string{
+		"../secret.txt",
+		`..\secret.txt`,
+		"./../secret.txt",
+		"data/../../secret.txt",
+		`data\..\..\secret.txt`,
+	} {
+		if path, ok := manager.Find(name); ok {
+			t.Fatalf("Find(%q) escaped the root: %s", name, path)
+		}
+		if data, err := manager.ReadFile(name); err == nil {
+			t.Fatalf("ReadFile(%q) returned %q", name, data)
+		}
+	}
+
+	for _, name := range []string{"data/clientinfo.xml", `data\clientinfo.xml`, "./data/clientinfo.xml"} {
+		if _, ok := manager.Find(name); !ok {
+			t.Fatalf("Find(%q) should still resolve inside the root", name)
+		}
+	}
+}
