+func buildHardeningTGA(imageType byte, width, height uint16, pixels []byte) []byte {
+	header := make([]byte, 18)
+	header[2] = imageType
+	binary.LittleEndian.PutUint16(header[12:14], width)
+	binary.LittleEndian.PutUint16(header[14:16], height)
+	header[16] = 32
+	return append(header, pixels...)
+}
