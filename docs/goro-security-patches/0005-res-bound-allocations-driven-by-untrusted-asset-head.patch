diff --git a/res/grf_hardening_test.go b/res/grf_hardening_test.go
new file mode 100644
index 0000000..4fdc186
--- /dev/null
+++ b/res/grf_hardening_test.go
@@ -0,0 +1,202 @@
+package res
+
+import (
+	"bytes"
+	"encoding/binary"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+type hardeningGRFEntry struct {
+	name        string
+	packedSize  uint32
+	alignedSize uint32
+	realSize    uint32
+	entryType   byte
+	offset      uint32
+}
+
+func buildHardeningGRF(body []byte, entries []hardeningGRFEntry) []byte {
+	var table bytes.Buffer
+	for _, entry := range entries {
+		table.WriteString(entry.name)
+		table.WriteByte(0)
+		writeU32(&table, entry.packedSize)
+		writeU32(&table, entry.alignedSize)
+		writeU32(&table, entry.realSize)
+		table.WriteByte(entry.entryType)
+		writeU32(&table, entry.offset)
+	}
+	compressedTable := zlibBytes(table.Bytes())
+
+	var out bytes.Buffer
+	header := make([]byte, grfHeaderSize)
+	copy(header[:15], []byte("Master of Magic"))
+	binary.LittleEndian.PutUint32(header[30:34], uint32(len(body)))
+	binary.LittleEndian.PutUint32(header[34:38], 0)
+	binary.LittleEndian.PutUint32(header[38:42], uint32(len(entries))+7)
+	binary.LittleEndian.PutUint32(header[42:46], grfVersion200)
+	out.Write(header)
+	out.Write(body)
+	writeU32(&out, uint32(len(compressedTable)))
+	writeU32(&out, uint32(table.Len()))
+	out.Write(compressedTable)
+	return out.Bytes()
+}
+
+func writeHardeningGRF(t *testing.T, data []byte) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "data.grf")
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestOpenGRFRejectsPackedSizeAboveAlignedSize(t *testing.T) {
+	body := zlibBytes([]byte("hello world"))
+	data := buildHardeningGRF(body, []hardeningGRFEntry{{
+		name:        `data\hello.txt`,
+		packedSize:  1024,
+		alignedSize: uint32(len(body)),
+		realSize:    11,
