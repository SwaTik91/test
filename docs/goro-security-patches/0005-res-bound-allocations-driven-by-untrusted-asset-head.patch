+		packedSize:  uint32(len(body)),
+		alignedSize: uint32(len(body)),
+		realSize:    11,
+		entryType:   0x01,
+	}}
+	tableHeader := grfHeaderSize + len(body)
+
+	t.Run("packed size past archive end", func(t *testing.T) {
+		data := buildHardeningGRF(body, entries)
+		binary.LittleEndian.PutUint32(data[tableHeader:tableHeader+4], 0xFFFFFFF0)
+		_, err := OpenGRF(writeHardeningGRF(t, data))
+		if err == nil || !strings.Contains(err.Error(), "file table truncated") {
