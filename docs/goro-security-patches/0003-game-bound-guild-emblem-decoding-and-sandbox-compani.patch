+// restrictSandbox removes the process, filesystem and native-loading surface
+// from AI scripts, which are loaded from the data directory or a GRF archive.
+func (ai *companionAI) restrictSandbox() {
+	L := ai.state
+	if osTable, ok := L.GetGlobal("os").(*lua.LTable); ok {
+		for _, name := range []string{"execute", "exit", "getenv", "remove", "rename", "setenv", "tmpname"} {
+			osTable.RawSetString(name, lua.LNil)
+		}
+	}
+	if ioTable, ok := L.GetGlobal("io").(*lua.LTable); ok {
+		ioTable.RawSetString("popen", lua.LNil)
+	}
+	if packageTable, ok := L.GetGlobal("package").(*lua.LTable); ok {
+		packageTable.RawSetString("loadlib", lua.LNil)
+	}
+	L.SetGlobal("debug", lua.LNil)
+}
