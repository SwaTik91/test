+// maxEmblemDimension leaves room above the 24x24 emblems the reference client
+// ships, while keeping a declared size from driving a large decode.
+const maxEmblemDimension = 128
+
+func checkEmblemDimensions(data []byte) error {
+	config, _, err := image.DecodeConfig(bytes.NewReader(data))
+	if err != nil {
+		return nil
+	}
+	if config.Width <= 0 || config.Height <= 0 || config.Width > maxEmblemDimension || config.Height > maxEmblemDimension {
+		return fmt.Errorf("emblem size %dx%d out of range", config.Width, config.Height)
+	}
+	return nil
+}
