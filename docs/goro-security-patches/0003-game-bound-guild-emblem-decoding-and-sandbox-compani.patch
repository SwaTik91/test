diff --git a/game/guild_emblem_hardening_test.go b/game/guild_emblem_hardening_test.go
new file mode 100644
index 0000000..ea4edf0
--- /dev/null
+++ b/game/guild_emblem_hardening_test.go
@@ -0,0 +1,80 @@
+package game
+
+import (
+	"bytes"
+	"compress/zlib"
+	"image"
+	"image/color"
+	"image/png"
+	"path/filepath"
+	"testing"
+)
+
+func compressEmblem(t *testing.T, payload []byte) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	writer := zlib.NewWriter(&buf)
+	if _, err := writer.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+func encodeEmblemPNG(t *testing.T, width, height int) []byte {
+	t.Helper()
+	img := image.NewNRGBA(image.Rect(0, 0, width, height))
+	img.Set(0, 0, color.NRGBA{R: 255, A: 255})
+	var buf bytes.Buffer
+	if err := png.Encode(&buf, img); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+func TestDecodeGuildEmblemImageRejectsOversizedDimensions(t *testing.T) {
+	data := compressEmblem(t, encodeEmblemPNG(t, maxEmblemDimension+1, 1))
+
+	if _, err := decodeGuildEmblemImage(data); err == nil {
+		t.Fatal("expected oversized emblem to be rejected")
+	}
+}
+
+func TestDecodeGuildEmblemImageAcceptsNormalEmblem(t *testing.T) {
+	data := compressEmblem(t, encodeEmblemPNG(t, 24, 24))
+
+	img, err := decodeGuildEmblemImage(data)
+	if err != nil {
+		t.Fatalf("expected emblem to decode, got %v", err)
+	}
+	if img.Bounds().Dx() != 24 || img.Bounds().Dy() != 24 {
+		t.Fatalf("unexpected emblem size %v", img.Bounds())
+	}
+}
+
+func TestCompanionAIIOPathRejectsEscapes(t *testing.T) {
+	root := filepath.Join(string(filepath.Separator), "data", "ro")
+	for _, path := range []string{
+		"../secret.txt",
+		"..\\secret.txt",
+		"AI/../../secret.txt",
+		filepath.Join(string(filepath.Separator), "etc", "passwd"),
+	} {
+		if resolved, ok := companionAIIOPath(root, path); ok {
+			t.Fatalf("expected %q to be rejected, resolved to %q", path, resolved)
+		}
+	}
+}
+
+func TestCompanionAIIOPathAllowsDataFiles(t *testing.T) {
+	root := filepath.Join(string(filepath.Separator), "data", "ro")
+	resolved, ok := companionAIIOPath(root, "AI\\USER_AI\\Config.lua")
+	if !ok {
+		t.Fatal("expected data directory path to be allowed")
+	}
+	if want := filepath.Join(root, "AI", "USER_AI", "Config.lua"); resolved != want {
+		t.Fatalf("resolved %q, want %q", resolved, want)
+	}
+}
